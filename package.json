{
  "name": "next-sql",
  "version": "1.0.18",
  "description": "Next-gen SQL connector, easy way to query SQL and create relationship linked object.",
  "keywords": [
    "sql",
    "mysql",
    "mysql2",
    "kenx",
    "query",
    "querybuilder",
    "connector",
    "db",
    "database",
    "database-js",
    "rds",
    "serverless"
  ],
  "author": "Cowboy Ho <info@cow-boy.net>",
  "license": "Apache-2.0",
  "types": "index.d.ts",
  "main": "index.js",
  "files": [
    "lib/**",
    "clients/**",
    "index.js",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/cow258/next-sql"
  },
  "scripts": {
    "dev": "node ./cli/dev",
    "cleanup": "rm -rf node_modules && rm yarn.lock",
    "lint:staged": "lint-staged",
    "lint:js": "eslint --ext .js .",
    "lint:fix": "eslint --ext .js --fix .",
    "test": "jest --coverage",
    "coveralls": "coveralls < coverage/lcov.info",
    "cli": "node ./cli",
    "format": "prettier --write \"**/*.d.ts\" --loglevel silent",
    "types": "yarn cli types clean && tsc --declaration --emitDeclarationOnly",
    "types:clean": "yarn cli types clean",
    "db:up": "docker-compose up -d",
    "db:start": "pnpm db:up && pnpm cli dbCheck",
    "db:down": "docker-compose down",
    "db:stop": "docker-compose stop",
    "db:clean": "rm -rf db/datadir",
    "db:reset": "pnpm db:down && pnpm db:clean && pnpm db:up && pnpm cli dbCheck"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "classnames": "^2.5.1",
    "sqlstring": "^2.3.3"
  },
  "devDependencies": {
    "@planetscale/database": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/mysql": "^2.15.27",
    "babel-eslint": "^10.1.0",
    "console.table": "^0.10.0",
    "coveralls-next": "^6.0.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^24.7.0",
    "glob": "^8.1.0",
    "husky": "^5.2.0",
    "jest": "^29.7.0",
    "lint-staged": "^10.5.4",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.4",
    "mysqldump": "^3.2.0",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@planetscale/database": "^1.6.0",
    "mysql": "^2.0.0",
    "mysql2": "^3.9.8"
  },
  "peerDependenciesMeta": {
    "mysql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "@planetscale/database": {
      "optional": true
    }
  },
  "resolutions": {
    "mysql2": "^3.14.4",
    "js-yaml": "^4.3.1",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "@tootallnate/once": "^2.0.1",
    "uuid": "^11.1.1",
    "form-data": "^4.0.6",
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2",
    "yaml": "^1.10.3",
    "lodash": "^4.18.0",
    "@babel/core": "^7.29.6",
    "fast-uri": "^3.1.5"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.14.4",
      "js-yaml": "^4.3.1",
      "braces": "^3.0.3",
      "micromatch": "^4.0.8",
      "@tootallnate/once": "^2.0.1",
      "uuid": "^11.1.1",
      "form-data": "^4.0.6",
      "flatted": "^3.4.2",
      "picomatch": "^2.3.2",
      "yaml": "^1.10.3",
      "lodash": "^4.18.0",
      "@babel/core": "^7.29.6",
      "fast-uri": "^3.1.5",
      "minimatch@3": "3.1.4",
      "minimatch@5": "5.1.8",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,md,css,scss,yaml,yml}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --ext .js --fix ."
    ]
  }
}